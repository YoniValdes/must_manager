<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jhonny.mustmanager" android:versionCode="21" android:versionName="0.21">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34"/>

    <!-- Android 11 y anteriores -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30"/>
    <!-- Android 12 y posteriores ("Dispositivos cercanos"); no se usa para localizar al usuario -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>

    <!-- Seguir conectado y grabando con la pantalla apagada -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Internet SOLO para buscar y descargar actualizaciones (Updater): una consulta pequeña al día a las
         Releases públicas de GitHub. Nunca se envía ningún dato de la batería ni del usuario.
         Sin conexión, la app funciona exactamente igual. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Pasar la APK descargada al instalador de Android (el usuario siempre confirma la instalación). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true"/>

    <application android:label="Must Manager" android:icon="@drawable/ic_launcher"
        android:allowBackup="false" android:theme="@style/AppTheme">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service android:name=".MonitorService" android:exported="false"
            android:foregroundServiceType="connectedDevice"/>
        <!-- Widget de la pantalla de inicio (SOC, consumo y autonomía). Los datos se los pasa MonitorService. -->
        <receiver android:name=".BatteryWidget" android:exported="false" android:label="Must Manager">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info"/>
        </receiver>
        <!-- Respuesta del instalador de Android al actualizar la app (Updater / InstallReceiver). -->
        <receiver android:name=".InstallReceiver" android:exported="false"/>
    </application>
</manifest>
