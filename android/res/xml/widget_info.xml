<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de la pantalla de inicio: 3×1 casillas por defecto, se puede estirar.
     updatePeriodMillis (30 min, el mínimo de Android) solo sirve para marcar "sin datos recientes"
     si el servicio dejó de mandar lecturas; los datos los envía MonitorService al momento. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="60dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="60dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget"
    android:previewLayout="@layout/widget"
    android:description="@string/widget_desc"
    android:widgetCategory="home_screen"/>
